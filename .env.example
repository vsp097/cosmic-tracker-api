# Copia este archivo como `.env` y rellena los valores.
# El archivo `.env` está en .gitignore y nunca debe subirse al repositorio.

# Conexión a PostgreSQL.
# Con el docker-compose de este repositorio, este valor funciona tal cual:
DATABASE_URL=postgresql://postgres@localhost:5433/cosmic_tracker

# Clave para firmar los tokens JWT. Genera una propia, no uses esta.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Llave gratuita de la API de la NASA: https://api.nasa.gov
# DEMO_KEY funciona para probar, pero tiene un límite muy bajo de peticiones.
NASA_API_KEY=DEMO_KEY
